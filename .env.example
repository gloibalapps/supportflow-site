# Payment tracker and Premium. Price IDs are not secrets. Set them in Netlify.
# Use TEST-mode price IDs when testing. Leave a value empty until the Stripe object exists.
#
# Basic checkout is unchanged: STRIPE_PRICE_79 is the existing A$79 one-off (STRIPE_PRICE_49 still read as fallback).
# Second device is the existing licence upgrade: STRIPE_PRICE_UPGRADE (A$29 one-off).
#
# Payment tracker add-on: one-off Price of A$29.00 AUD, on top of Basic.
# Do not point this at any retired price or the old second-computer upgrade price.
STRIPE_PRICE_TRACKER=
#
# Premium: one-off Price of A$129.00 AUD. No discounts or coupons. Do not commit secret keys.
STRIPE_PRICE_TRACKER_FULL=
#
# Optional SMS: recurring monthly Price of A$4.99 AUD for 50 texts.
# Not included in Basic, the tracker, or Premium. Offered after the tracker is unlocked.
# Previously created live Price. Confirm it is still A$4.99 AUD / month before relying on it.
STRIPE_PRICE_TRACKER_SMS=price_1UYEAyKJKDCaYKVvPWR5MQ3R
#
# Retired. Checkout refuses these. Do not create new Prices for them.
# Older payments (tracker_base, tracker_two, tracker_addon) still unlock.
# STRIPE_PRICE_TRACKER_BASE=
# STRIPE_PRICE_TRACKER_TWO=
# STRIPE_PRICE_TRACKER_ADDON=

# Secrets: set in Netlify only, never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TRACKER_DATA_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
TRACKER_AUTOSEND_ENABLED=
TRACKER_AUTOSEND_DRY_RUN=true
TRACKER_SMS_ENABLED=
TRACKER_SMS_DRY_RUN=true
